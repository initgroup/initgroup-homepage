{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "INIT Homepage: Setup Venv",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\setup-venv.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "INIT Homepage: Run Server",
            "type": "process",
            "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "args": ["-u", "-m", "http.server", "8200", "--bind", "127.0.0.1", "--directory", "${workspaceFolder}"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": "INIT Homepage: Setup Venv",
            "dependsOrder": "sequence",
            "runOptions": { "instanceLimit": 1 },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": true }
        },
        {
            "label": "INIT Homepage: Validate",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\validate.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "INIT Homepage: Backup Working Source",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\backup-source.ps1", "-Mode", "Working"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "INIT Homepage: Backup Git Source",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\backup-source.ps1", "-Mode", "Git"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "INIT Homepage: Publish Main (Explicit Commit + Push)",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\git-publish-main.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
