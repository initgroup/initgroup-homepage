# Portable static hosting: no Python, PHP, database or application routing.
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType video/mp4 .mp4
AddType font/woff2 .woff2
Options -Indexes
ErrorDocument 404 default
ErrorDocument 410 default

# Retired content must stay unavailable even when old uploads remain on disk.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Normalize only the production aliases. Preview/relocated hosts stay untouched.
    RewriteCond %{HTTP_HOST} ^www\.initgroup\.kr(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://initgroup.kr%{REQUEST_URI} [R=301,L,NE]
    RewriteCond %{HTTP_HOST} ^initgroup\.kr(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    # Cafe24 may terminate TLS at its front proxy; avoid an HTTPS redirect loop.
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https(?:\s*,|$) [NC]
    RewriteRule ^ https://initgroup.kr%{REQUEST_URI} [R=301,L,NE]
    # Only content-versioned public assets receive immutable caching.
    RewriteCond %{QUERY_STRING} (?:^|&)v=[a-f0-9]{16}(?:&|$)
    RewriteRule ^assets/(?!shared/site\.json$).+\.(?:css|js|json|html|png|jpe?g|webp|svg|ico|pdf|mp4|woff2)$ - [E=INIT_VERSIONED:1]
    RewriteRule ^insights(?:/|$) - [G,L]
    # Retired product artwork must not be indexed under the former brand.
    RewriteRule ^assets/images/brand/indeps_(?:banner|compact)_(?:ko|en|bilingual)\.(?:svg|png)$ - [G,L,NC]
    RewriteRule ^assets/videos/initgroup-promo-indeps_flow\.png$ - [G,L,NC]
    RewriteRule ^assets/brand-2026/(?:assets-manifest\.json|company\.webp|gaon-plaza\.webp|icons\.svg|research\.webp)$ - [G,L]
    RewriteRule ^assets/(?:images/menu-heroes/insights-hero-desktop-v2\.png|images/product/login-overview\.png|videos/initgroup-promo-(?:poster\.jpg|preview\.mp4))$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'"
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Cache-Control "public, max-age=31536000, immutable" env=INIT_VERSIONED
</IfModule>
